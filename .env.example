# Copy to .env and fill in. Every value marked REQUIRED has no default on purpose. Never commit .env.

# ---- Neon (Postgres) -------------------------------------------------------
# REQUIRED. Neon console > your project > Connection string (includes sslmode=require).
# Neon console > your project > Connect > copy the connection string.
DATABASE_URL=

# ---- Gemini ----------------------------------------------------------------
# REQUIRED. Google AI Studio API key.
GEMINI_API_KEY=
# REQUIRED. Model id from Google's current model list. No default: choose a fast, low-latency one for live calls.
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=15000

# ---- Vaani (vaanivoice.ai) -------------------------------------------------
# Docs: https://docs.vaanivoice.ai
# REQUIRED. Long random strings you generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# VAANI_WEBHOOK_SECRET goes in the webhook URL you register: https://<host>/vaani/webhook/<VAANI_WEBHOOK_SECRET>
VAANI_WEBHOOK_SECRET=
# VAANI_BYOL_TOKEN is the "Auth Token" in Vaani: Brain > Reasoning Language Model > BYOL. WebSocket URL: wss://<host>/vaani/llm
VAANI_BYOL_TOKEN=
# Needed only for the confirmation call-back (otherwise the front desk gets an email task instead).
# API key from the Vaani dashboard (starts with vaani_), and the agent_id of the second, confirmation agent.
VAANI_API_KEY=
# The inbound agent. With this set, the server keeps its opening greeting right for the time of day (src/greeting.js).
VAANI_AGENT_ID=
VAANI_CONFIRM_AGENT_ID=
# Optional caller id in E.164 format.
VAANI_OUTBOUND_NUMBER=

# ---- Email (Resend) --------------------------------------------------------
# REQUIRED. Resend API key (starts with re_).
RESEND_API_KEY=
# REQUIRED. Sender. Must be an address your Resend account allows (a verified domain, or Resend's test sender while testing).
EMAIL_FROM=
# REQUIRED. Comma-separated recipients. Gmail addresses are fine.
EMAIL_DESIGNERS=
EMAIL_ESCALATION=
EMAIL_FRONTDESK=
# REQUIRED. Public HTTPS address of this server, used in the Claim / Won / Lost links inside emails.
PUBLIC_BASE_URL=
# REQUIRED. Long random string that signs those links. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ACTION_LINK_SECRET=

# ---- Cal.com ---------------------------------------------------------------
# REQUIRED. API key (starts with cal_).
CALCOM_API_KEY=
# REQUIRED. Event type ids from Cal.com (one for site visits, one for phone consultations).
CALCOM_EVENT_TYPE_ID_SITE_VISIT=
CALCOM_EVENT_TYPE_ID_PHONE=
# REQUIRED. Per-endpoint version headers. Values shown on Cal.com's reference pages when this was written:
CALCOM_SLOTS_API_VERSION=2024-09-04
CALCOM_BOOKINGS_API_VERSION=2026-02-25
# REQUIRED for the Cal.com webhook. Set the same secret in Cal.com's webhook settings.
CALCOM_WEBHOOK_SECRET=
# CALCOM_BASE_URL=https://api.cal.com

# ---- HubSpot ---------------------------------------------------------------
# REQUIRED. Private app access token with crm.objects.contacts.read/write and crm.objects.deals.read/write.
HUBSPOT_ACCESS_TOKEN=
# Optional. Leave empty to use the default pipeline.
HUBSPOT_PIPELINE_ID=
# REQUIRED. Internal stage ids (not labels) from your deal pipeline.
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_BOOKED=
HUBSPOT_STAGE_WON=
HUBSPOT_STAGE_LOST=
HUBSPOT_STAGE_DECLINED=
HUBSPOT_STAGE_OTHER=
# REQUIRED. Association type id for deal to contact, from HubSpot's associations guide.
HUBSPOT_DEAL_TO_CONTACT_ASSOC_ID=

# ---- Cost rates (INR). Optional: leave empty and cost amounts stay blank, never guessed ----
RATE_GEMINI_INPUT_INR_PER_MTOK=
RATE_GEMINI_OUTPUT_INR_PER_MTOK=
RATE_VOICE_INR_PER_MINUTE=

# ---- Dashboard login ------------------------------------------------------
# Optional. Leave EMPTY for an open dashboard (first names and totals only, no notes). Set a long password to require a login and show full details.
DASHBOARD_PASSWORD=
# Optional separate secret for signing the session cookie (otherwise derived from ACTION_LINK_SECRET).
DASHBOARD_SESSION_SECRET=

# ---- Behaviour (defaults shown) -------------------------------------------
PORT=8080
MAX_CLARIFY_TURNS=3
MIN_TRANSCRIPT_CHARS=60
SCHEDULE_WINDOW_DAYS=14
CONFIRM_MAX_ATTEMPTS=2
STUDIO_TIME_ZONE=Asia/Kolkata
